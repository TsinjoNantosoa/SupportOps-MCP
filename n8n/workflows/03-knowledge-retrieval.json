{
  "name": "SupportOps 03 - Knowledge Retrieval",
  "nodes": [
    {
      "parameters": {"inputSource": "passthrough"},
      "id": "a3000003-0000-4000-8000-000000000001",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-560, 0]
    },
    {
      "parameters": {
        "jsCode": "const query = String($json.query || '').trim();\nif (query.length < 2 || query.length > 200) throw new Error('VALIDATION_ERROR: query length must be 2-200');\nreturn [{json: {...$json, query}}];"
      },
      "id": "a3000003-0000-4000-8000-000000000002",
      "name": "Validate Knowledge Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "serverTransport": "httpStreamable",
        "endpointUrl": "http://supportops-knowledge:8002/mcp",
        "authentication": "none",
        "tool": {"mode": "id", "value": "search_knowledge"},
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ query: $json.query, limit: 5 }) }}",
        "options": {"timeout": 30000}
      },
      "id": "a3000003-0000-4000-8000-000000000003",
      "name": "Search Knowledge via MCP",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "jsCode": "const results = $json.results || $json.structuredContent?.results || [];\nif (!Array.isArray(results) || results.length === 0) return [{json:{found:false, results:[], message:'No allowlisted procedure matched the query.'}}];\nreturn [{json:{found:true, results, procedure_id:results[0].procedure_id}}];"
      },
      "id": "a3000003-0000-4000-8000-000000000004",
      "name": "Handle Missing Procedure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict", "version": 2},
          "conditions": [
            {
              "id": "a3000003-found-condition",
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "true", "singleValue": true}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a3000003-0000-4000-8000-000000000005",
      "name": "Procedure Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [380, 0]
    },
    {
      "parameters": {
        "serverTransport": "httpStreamable",
        "endpointUrl": "http://supportops-knowledge:8002/mcp",
        "authentication": "none",
        "tool": {"mode": "id", "value": "get_procedure"},
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ procedure_id: $json.procedure_id }) }}",
        "options": {"timeout": 30000}
      },
      "id": "a3000003-0000-4000-8000-000000000006",
      "name": "Get Best Procedure via MCP",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [620, -100]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{found:false,results:[],message:$json.message||'No allowlisted procedure matched the query.'}}];"
      },
      "id": "a3000003-0000-4000-8000-000000000007",
      "name": "Return Explicit No Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 100]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {"main": [[{"node": "Validate Knowledge Query", "type": "main", "index": 0}]]},
    "Validate Knowledge Query": {"main": [[{"node": "Search Knowledge via MCP", "type": "main", "index": 0}]]},
    "Search Knowledge via MCP": {"main": [[{"node": "Handle Missing Procedure", "type": "main", "index": 0}]]},
    "Handle Missing Procedure": {"main": [[{"node": "Procedure Found?", "type": "main", "index": 0}]]},
    "Procedure Found?": {
      "main": [
        [{"node": "Get Best Procedure via MCP", "type": "main", "index": 0}],
        [{"node": "Return Explicit No Match", "type": "main", "index": 0}]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "a3000003-0000-4000-8000-000000000099",
  "meta": {"supportopsTargetN8n": "2.45.7"},
  "tags": []
}
